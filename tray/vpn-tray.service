[Unit]
Description=VPN-L2TP tray indicator
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Под Wayland приложение не может расположить своё окно; через XWayland
# окно настроек открывается по центру экрана.
Environment=GDK_BACKEND=x11
ExecStart=/usr/bin/python3 @TRAY_DIR@/vpn-tray.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
