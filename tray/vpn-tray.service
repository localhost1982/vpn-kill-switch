[Unit]
Description=VPN-L2TP tray indicator
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Under Wayland an application cannot position its own window; via XWayland
# the settings window opens centered on the screen.
Environment=GDK_BACKEND=x11
ExecStart=/usr/bin/python3 @TRAY_DIR@/vpn-tray.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
