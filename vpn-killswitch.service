[Unit]
Description=VPN kill switch (nftables): internet only via the VPN tunnel
# Load the rules before NetworkManager brings the network up.
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/killswitch.nft
ExecReload=/usr/sbin/nft -f /etc/nftables.d/killswitch.nft
ExecStop=/usr/sbin/nft delete table inet killswitch

[Install]
WantedBy=multi-user.target
